{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ficha da campanha · formato 1",
  "type": "object",
  "properties": {
    "versaoFormato": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "enum": [
        "pj",
        "npc"
      ]
    },
    "edicao": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "nivel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "subclasse": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nivel"
        ]
      }
    },
    "atributos": {
      "type": "object",
      "properties": {
        "for": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "des": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "con": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "int": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "sab": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "car": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "for",
        "des",
        "con",
        "int",
        "sab",
        "car"
      ]
    },
    "pvMaximos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "caBase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "deslocamentosM": {
      "type": "object",
      "properties": {
        "andar": {
          "type": "number",
          "minimum": 0
        },
        "nadar": {
          "type": "number"
        },
        "voar": {
          "type": "number"
        },
        "escalar": {
          "type": "number"
        },
        "escavar": {
          "type": "number"
        }
      },
      "required": [
        "andar"
      ]
    },
    "proficiencia": {
      "type": "integer"
    },
    "salvaguardas": {
      "type": "object",
      "properties": {
        "for": {
          "type": "integer"
        },
        "des": {
          "type": "integer"
        },
        "con": {
          "type": "integer"
        },
        "int": {
          "type": "integer"
        },
        "sab": {
          "type": "integer"
        },
        "car": {
          "type": "integer"
        }
      },
      "required": []
    },
    "pericias": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "recursos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recurso"
      }
    },
    "opcoes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opcao"
      }
    },
    "preparacao": {
      "type": "object",
      "properties": {
        "vagas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 150
        },
        "preparadas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          }
        },
        "semprePreparadas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          }
        }
      },
      "required": [
        "vagas",
        "preparadas",
        "semprePreparadas"
      ]
    },
    "equipamentos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inventario": {
      "type": "object",
      "properties": {
        "capacidadeCargaKg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "itens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
              "nome": {"type": "string", "minLength": 1},
              "descricao": {"type": "string"},
              "tipo": {"enum": ["equipamento", "consumivel", "etc", "moeda"]},
              "quantidade": {"type": "integer", "minimum": 1, "maximum": 999999},
              "empilhavel": {"type": "boolean"},
              "pesoKg": {"type": "number", "minimum": 0},
              "slotEquipamento": {"enum": ["cabeca", "capa", "vestes", "botas", "mao_forte", "mao_fraca", "arma_distancia", "colar", "acessorio", "acessorio_1", "acessorio_2"]},
              "equipado": {"type": "boolean"},
              "equipadoSlot": {"enum": ["cabeca", "capa", "vestes", "botas", "mao_forte", "mao_fraca", "arma_distancia", "colar", "acessorio_1", "acessorio_2"]},
              "moeda": {"enum": ["po", "pp", "pc", "pe", "pl"]},
              "icone": {"type": "string"},
              "acoes": {
                "type": "array",
                "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}
              },
              "modificadores": {
                "type": "object",
                "additionalProperties": {"type": "number"}
              },
              "classeArmadura": {
                "type": "object",
                "properties": {
                  "tipo": {"enum": ["base", "bonus"]},
                  "valor": {"type": "number"}
                },
                "required": ["tipo", "valor"]
              }
            },
            "required": ["id", "nome", "tipo", "quantidade", "pesoKg"]
          }
        }
      },
      "required": ["capacidadeCargaKg", "itens"]
    },
    "passivas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "efeitos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "condicoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resistencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "imunidades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vulnerabilidades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tamanho": {
      "type": "string"
    },
    "especie": {
      "type": "string"
    },
    "idiomas": {
      "type": [
        "string",
        "array"
      ]
    },
    "sentidos": {
      "type": [
        "string",
        "object"
      ]
    },
    "concentracao": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "versaoFormato",
    "id",
    "nome",
    "tipo",
    "classes",
    "atributos",
    "pvMaximos",
    "caBase",
    "deslocamentosM",
    "recursos",
    "opcoes"
  ],
  "$defs": {
    "recurso": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "nome": {
          "type": "string"
        },
        "origem": {
          "type": "string"
        },
        "maximo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "saldoInicial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "unidade": {
          "type": "string"
        },
        "recuperacao": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evento": {
                "type": "string"
              },
              "modo": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              }
            },
            "required": [
              "evento",
              "modo"
            ]
          }
        }
      },
      "required": [
        "id",
        "nome",
        "maximo",
        "saldoInicial"
      ]
    },
    "opcao": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "nome": {
          "type": "string"
        },
        "categoria": {
          "type": "string"
        },
        "descricao": {
          "type": "string"
        },
        "origem": {
          "type": "string"
        },
        "circuloBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "ritual": {
          "type": "boolean"
        },
        "concentracao": {
          "type": "boolean"
        },
        "foraCombate": {
          "type": "boolean"
        },
        "duracao": {
          "type": "string"
        },
        "componentes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custo": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tipo": {
                "enum": [
                  "acao",
                  "bonus",
                  "reacao",
                  "recurso"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "quantidade": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              }
            },
            "required": [
              "tipo",
              "quantidade"
            ]
          }
        },
        "gatilhosAlternativos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gatilho": {
          "enum": [
            "sair_alcance",
            "sofrer_dano",
            "ser_alvo",
            "falhar_teste",
            "conjurar_magia",
            "ser_atingido",
            "apos_acerto",
            "apos_rolagem_d20",
            "apos_rolagem_dano"
          ]
        },
        "umaVezPorTurno": {
          "type": "boolean"
        },
        "aprimoramento": {
          "type": "object",
          "properties": {
            "dano": {"type": "string"},
            "elemento": {"type": "string"},
            "critico": {"type": "boolean"},
            "requisitos": {
              "type": "object",
              "properties": {
                "tagsAtaque": {"type": "array", "items": {"type": "string"}},
                "alvoFerido": {"type": "boolean"}
              }
            },
            "salva": {
              "type": "object",
              "properties": {
                "atributo": {"enum": ["for", "des", "con", "int", "sab", "car"]},
                "cd": {"type": "integer", "minimum": 1, "maximum": 40},
                "efeitoFalha": {"type": "object"}
              },
              "required": ["atributo", "cd"]
            }
          },
          "required": ["dano"]
        },
        "rerrolagem": {
          "type": "object",
          "properties": {
            "tipo": {"enum": ["dano", "d20"]},
            "modo": {"enum": ["todos", "dados_com_resultado"]},
            "resultados": {"type": "array", "items": {"type": "integer", "minimum": 1}}
          },
          "required": ["tipo", "modo"]
        },
        "requisitos": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "requisitosUso": {
          "type": "object",
          "properties": {
            "aposAtaque": {"type": "boolean"},
            "aposAcerto": {"type": "boolean"},
            "tagsAtaqueAnterior": {"type": "array", "items": {"type": "string"}},
            "umaVezPorTurno": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
            "alvoDiferenteDoAnterior": {"type": "boolean"},
            "distanciaDoAlvoAnteriorM": {"type": "number", "minimum": 0}
          }
        },
        "selecao": {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string"
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            },
            "aceita": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "alcanceM": {
              "type": "number"
            },
            "alcanceLongoM": {
              "type": "number"
            },
            "forma": {
              "type": "string"
            },
            "raioM": {
              "type": "number"
            },
            "area": {
              "type": "object",
              "properties": {
                "forma": {"enum": ["circulo", "quadrado", "cone", "linha"]},
                "raioM": {"type": "number", "exclusiveMinimum": 0},
                "tamanhoM": {"type": "number", "exclusiveMinimum": 0},
                "comprimentoM": {"type": "number", "exclusiveMinimum": 0},
                "larguraM": {"type": "number", "exclusiveMinimum": 0}
              },
              "required": ["forma"]
            },
            "comprimentoM": {
              "type": "number"
            },
            "larguraM": {
              "type": "number"
            },
            "repetirAlvo": {
              "type": "boolean"
            },
            "visao": {
              "type": "boolean"
            }
          },
          "required": []
        },
        "etapas": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "efeitos": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "escalonamento": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "automacao": {
          "type": "object",
          "properties": {
            "tipo": {
              "enum": [
                "ataque",
                "salva",
                "cura",
                "pv_temporario",
                "estabilizar",
                "disparada",
                "desengajar",
                "economia",
                "efeito",
                "efeito_conjuracao",
                "projeteis",
                "bencao",
                "reduzir_dano",
                "conceder_dado"
              ]
            },
            "alcanceM": {
              "type": "number"
            },
            "bonus": {
              "type": "integer"
            },
            "dano": {
              "type": "string"
            },
            "ataques": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "bonus": {"type": "integer"},
                  "dano": {"type": "string"},
                  "elemento": {"type": "string"},
                  "alcanceM": {"type": "number"},
                  "tags": {"type": "array", "items": {"type": "string"}}
                },
                "required": ["bonus", "dano"]
              }
            },
            "formula": {
              "type": "string"
            },
            "modificador": {
              "type": "object",
              "properties": {
                "nome": {"type": "string"},
                "descricao": {"type": "string"},
                "formula": {"type": "string"},
                "tipos": {"type": "array", "items": {"enum": ["ataque", "salvaguarda", "teste"]}},
                "removeAoUsar": {"type": "boolean"},
                "removeEm": {"enum": ["descanso_curto", "descanso_longo"]}
              }
            },
            "valor": {
              "type": "integer"
            },
            "multiplicador": {
              "type": "number"
            },
            "adicionar": {
              "type": "object",
              "properties": {
                "acao": {"type": "integer", "minimum": 0, "maximum": 5},
                "bonus": {"type": "integer", "minimum": 0, "maximum": 5},
                "reacao": {"type": "integer", "minimum": 0, "maximum": 5}
              }
            },
            "disparada": {"type": "boolean"},
            "desengajar": {"type": "boolean"},
            "esquivar": {"type": "boolean"},
            "pvTemporarios": {"type": "integer", "minimum": 1},
            "cura": {"type": "string"},
            "recuperarRecursos": {"type": "array", "items": {"type": "string"}},
            "elemento": {
              "type": "string"
            },
            "atributo": {
              "enum": [
                "for",
                "des",
                "con",
                "int",
                "sab",
                "car"
              ]
            },
            "atributos": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "for",
                  "des",
                  "con",
                  "int",
                  "sab",
                  "car"
                ]
              }
            },
            "cd": {
              "type": "integer"
            },
            "metade": {
              "type": "boolean"
            },
            "raioM": {
              "type": "number"
            },
            "deslocamentoForcado": {
              "type": "object",
              "properties": {
                "distanciaM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "direcao": {
                  "const": "afastar"
                }
              },
              "required": [
                "distanciaM",
                "direcao"
              ]
            },
            "turnos": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "origem": {
              "type": "string"
            },
            "bonusCD": {
              "type": "integer"
            },
            "vantagemAtaque": {
              "type": "boolean"
            },
            "efeito": {
              "type": "object"
            },
            "origemArea": {
              "enum": [
                "conjurador"
              ]
            },
            "excluirConjurador": {
              "type": "boolean"
            },
            "efeitoFalha": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string"
                },
                "turnos": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "penalidadeProximaSalva": {
                  "type": "string"
                },
                "consomeReacao": {
                  "type": "boolean"
                },
                "condicao": {
                  "enum": [
                    "agarrado",
                    "amedrontado",
                    "atordoado",
                    "caido",
                    "cego",
                    "enfeiticado",
                    "envenenado",
                    "incapacitado",
                    "inconsciente",
                    "imobilizado",
                    "invisivel",
                    "paralisado",
                    "surdo"
                  ]
                },
                "expira": {
                  "enum": [
                    "inicio_alvo",
                    "fim_alvo",
                    "inicio_origem",
                    "fim_origem"
                  ]
                }
              },
              "required": [
                "nome",
                "turnos"
              ]
            }
          },
          "required": [
            "tipo"
          ]
        }
      },
      "required": [
        "id",
        "nome"
      ]
    }
  }
}
