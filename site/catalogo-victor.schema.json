{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["versaoFormato", "loja", "itens"],
  "properties": {
    "versaoFormato": {"const": 2},
    "loja": {"type": "string", "minLength": 1},
    "itens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ref"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "ref": {"type": "string", "pattern": "^item\\.[a-z0-9.-]+$"},
          "ajustes": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
