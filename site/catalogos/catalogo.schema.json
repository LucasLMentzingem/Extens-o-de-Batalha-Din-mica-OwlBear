{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo central da extensão",
  "type": "object",
  "required": ["versaoCatalogo"],
  "properties": {
    "versaoCatalogo": {"type": "integer", "minimum": 1},
    "habilidades": {"type": "array", "items": {"$ref": "#/$defs/entrada"}},
    "itens": {"type": "array", "items": {"$ref": "#/$defs/entrada"}},
    "lojas": {"type": "array", "items": {"type": "object", "required": ["id", "nome", "itens"]}}
  },
  "$defs": {
    "entrada": {
      "type": "object",
      "required": ["id", "revisao", "definicao"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
        "revisao": {"type": "integer", "minimum": 1},
        "definicao": {"type": "object", "required": ["nome"], "properties": {"visual": {"$ref": "#/$defs/visualHabilidade"}}}
      },
      "additionalProperties": false
    },
    "visualHabilidade": {
      "type": "object",
      "properties": {
        "arteId": {"type": "string", "minLength": 1},
        "arquivo": {"type": "string", "pattern": "^(\\.?/?assets/|https://)"},
        "familia": {"enum": ["origem", "comum", "raca", "classe"]},
        "layout": {"enum": ["ilustracao", "texto"]},
        "textoCurto": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
